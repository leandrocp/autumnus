{
  "name": "{pkg_name}",
  "version": "{npm_version}",
  "type": "module",
  "types": "./index.d.ts",
  "description": "Self-contained Lumis language package for {languages_text}",
  "author": "Leandro Pereira",
  "license": "MIT",
  "homepage": "https://lumis.sh",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/leandrocp/lumis.git"
  },
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./{wasm_name}.wasm": "./{wasm_name}.wasm",
    "./language.json": "./language.json"
  },
  "lumis": {
    "languages": {languages_json},
    "parser": "{wasm_name}",
    "upstreamVersion": "{upstream_version}",
    "rev": "{rev}",
    "treeSitter": "{tree_sitter_cli}",
    "formatVersion": 3,
    "definitionHash": "{definition_hash}",
    "sha256": "{sha256}",
    "size": {wasm_size}
  },
  "keywords": ["lumis-sh", "wasm", "tree-sitter"],
  "files": ["*.wasm", "*.json", "*.js", "*.d.ts", "README.md", "LICENSE"]
}
