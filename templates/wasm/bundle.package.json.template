{
  "name": "{package_name}",
  "version": "{version}",
  "description": "{description}",
  "author": "Leandro Pereira",
  "license": "MIT",
  "homepage": "https://lumis.sh",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/leandrocp/lumis.git"
  },
  "bugs": "https://github.com/leandrocp/lumis/issues",
  "keywords": ["lumis-sh", "tree-sitter", "wasm", "bundle"],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.js",
      "default": "./index.js"
    }
  },
  "files": ["index.js", "index.d.ts", "README.md"],
  "publishConfig": {
    "access": "public"
  },
  "lumis": { "bundleFormat": {bundle_format} },
  "peerDependencies": {
    "@lumis-sh/lumis": "{lumis_range}"
  },
  "dependencies": {dependencies}
}
