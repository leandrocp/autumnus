{
  "$comment": [
    "Annotation composition, pinned between Rust and the TypeScript port.",
    "",
    "`compose_annotations` in crates/lumis-core/src/annotations.rs and",
    "`composeAnnotations` in packages/javascript/lumis/src/annotations.ts are two",
    "implementations of one algorithm. Rust is the reference; the browser cannot",
    "call into it, so AGENTS.md requires a test pinning both against the same input.",
    "",
    "Each case supplies synthetic syntax events rather than highlighting real",
    "source, so what is under test is the composition alone: where a syntax scope",
    "has to be closed and reopened around an annotation boundary, how overlapping",
    "and nested annotations nest, and which offsets are rejected.",
    "",
    "`expected` is one stream both runtimes must produce, not a column each. They",
    "are a port, so a divergence is a bug rather than something to record.",
    "",
    "Notation: S:<scope> opens a syntax scope, E closes one, T:<start>-<end> is a",
    "source span in UTF-8 bytes, A+<properties>@<start>-<end> opens an annotation",
    "and A- closes it. `ERROR: ...` is the message both must raise, verbatim."
  ],
  "cases": [
    {
      "name": "passthrough/no-annotations",
      "source": "let total = 1;",
      "events": [
        {
          "type": "source",
          "startByte": 0,
          "endByte": 4
        },
        {
          "type": "start",
          "scope": "variable",
          "language": "rust"
        },
        {
          "type": "source",
          "startByte": 4,
          "endByte": 9
        },
        {
          "type": "end"
        },
        {
          "type": "source",
          "startByte": 9,
          "endByte": 14
        }
      ],
      "annotations": [],
      "expected": "T:0-4 S:variable T:4-9 E T:9-14"
    },
    {
      "name": "flat/whole-source",
      "source": "let total = 1;",
      "events": [
        {
          "type": "source",
          "startByte": 0,
          "endByte": 14
        }
      ],
      "annotations": [
        {
          "range": {
            "type": "offset",
            "start": 0,
            "end": 14
          },
          "properties": "whole"
        }
      ],
      "expected": "A+whole@0-14 T:0-14 A-"
    },
    {
      "name": "scope/annotation-inside-scope",
      "source": "let total = 1;",
      "events": [
        {
          "type": "source",
          "startByte": 0,
          "endByte": 4
        },
        {
          "type": "start",
          "scope": "variable",
          "language": "rust"
        },
        {
          "type": "source",
          "startByte": 4,
          "endByte": 9
        },
        {
          "type": "end"
        },
        {
          "type": "source",
          "startByte": 9,
          "endByte": 14
        }
      ],
      "annotations": [
        {
          "range": {
            "type": "offset",
            "start": 5,
            "end": 8
          },
          "properties": "inside"
        }
      ],
      "expected": "T:0-4 S:variable T:4-5 E A+inside@5-8 S:variable T:5-8 E A- S:variable T:8-9 E T:9-14"
    },
    {
      "name": "scope/annotation-exactly-scope",
      "source": "let total = 1;",
      "events": [
        {
          "type": "source",
          "startByte": 0,
          "endByte": 4
        },
        {
          "type": "start",
          "scope": "variable",
          "language": "rust"
        },
        {
          "type": "source",
          "startByte": 4,
          "endByte": 9
        },
        {
          "type": "end"
        },
        {
          "type": "source",
          "startByte": 9,
          "endByte": 14
        }
      ],
      "annotations": [
        {
          "range": {
            "type": "offset",
            "start": 4,
            "end": 9
          },
          "properties": "exact"
        }
      ],
      "expected": "T:0-4 A+exact@4-9 S:variable T:4-9 E A- T:9-14"
    },
    {
      "name": "scope/annotation-spans-scope-boundary",
      "source": "let total = 1;",
      "events": [
        {
          "type": "source",
          "startByte": 0,
          "endByte": 4
        },
        {
          "type": "start",
          "scope": "variable",
          "language": "rust"
        },
        {
          "type": "source",
          "startByte": 4,
          "endByte": 9
        },
        {
          "type": "end"
        },
        {
          "type": "source",
          "startByte": 9,
          "endByte": 14
        }
      ],
      "annotations": [
        {
          "range": {
            "type": "offset",
            "start": 2,
            "end": 11
          },
          "properties": "spanning"
        }
      ],
      "expected": "T:0-2 A+spanning@2-11 T:2-4 S:variable T:4-9 E T:9-11 A- T:11-14"
    },
    {
      "name": "multi/overlapping",
      "source": "let total = 1;",
      "events": [
        {
          "type": "source",
          "startByte": 0,
          "endByte": 14
        }
      ],
      "annotations": [
        {
          "range": {
            "type": "offset",
            "start": 0,
            "end": 8
          },
          "properties": "a"
        },
        {
          "range": {
            "type": "offset",
            "start": 4,
            "end": 12
          },
          "properties": "b"
        }
      ],
      "expected": "A+a@0-8 T:0-4 A+b@4-12 T:4-8 A- A- A+b@4-12 T:8-12 A- T:12-14"
    },
    {
      "name": "multi/nested",
      "source": "let total = 1;",
      "events": [
        {
          "type": "source",
          "startByte": 0,
          "endByte": 14
        }
      ],
      "annotations": [
        {
          "range": {
            "type": "offset",
            "start": 0,
            "end": 14
          },
          "properties": "outer"
        },
        {
          "range": {
            "type": "offset",
            "start": 4,
            "end": 9
          },
          "properties": "inner"
        }
      ],
      "expected": "A+outer@0-14 T:0-4 A+inner@4-9 T:4-9 A- T:9-14 A-"
    },
    {
      "name": "multi/adjacent",
      "source": "let total = 1;",
      "events": [
        {
          "type": "source",
          "startByte": 0,
          "endByte": 14
        }
      ],
      "annotations": [
        {
          "range": {
            "type": "offset",
            "start": 0,
            "end": 7
          },
          "properties": "left"
        },
        {
          "range": {
            "type": "offset",
            "start": 7,
            "end": 14
          },
          "properties": "right"
        }
      ],
      "expected": "A+left@0-7 T:0-7 A- A+right@7-14 T:7-14 A-"
    },
    {
      "name": "multi/identical-ranges",
      "source": "let total = 1;",
      "events": [
        {
          "type": "source",
          "startByte": 0,
          "endByte": 14
        }
      ],
      "annotations": [
        {
          "range": {
            "type": "offset",
            "start": 4,
            "end": 9
          },
          "properties": "first"
        },
        {
          "range": {
            "type": "offset",
            "start": 4,
            "end": 9
          },
          "properties": "second"
        }
      ],
      "expected": "T:0-4 A+first@4-9 A+second@4-9 T:4-9 A- A- T:9-14"
    },
    {
      "name": "position/single-line",
      "source": "let total = 1;",
      "events": [
        {
          "type": "source",
          "startByte": 0,
          "endByte": 14
        }
      ],
      "annotations": [
        {
          "range": {
            "type": "position",
            "start": {
              "line": 0,
              "column": 4
            },
            "end": {
              "line": 0,
              "column": 9
            }
          },
          "properties": "pos"
        }
      ],
      "expected": "T:0-4 A+pos@4-9 T:4-9 A- T:9-14"
    },
    {
      "name": "position/across-lines",
      "source": "let a = 1;\nlet b = 2;",
      "events": [
        {
          "type": "source",
          "startByte": 0,
          "endByte": 21
        }
      ],
      "annotations": [
        {
          "range": {
            "type": "position",
            "start": {
              "line": 0,
              "column": 4
            },
            "end": {
              "line": 1,
              "column": 5
            }
          },
          "properties": "multiline"
        }
      ],
      "expected": "T:0-4 A+multiline@4-16 T:4-16 A- T:16-21"
    },
    {
      "name": "position/line-end-column",
      "source": "let a = 1;\nlet b = 2;",
      "events": [
        {
          "type": "source",
          "startByte": 0,
          "endByte": 21
        }
      ],
      "annotations": [
        {
          "range": {
            "type": "position",
            "start": {
              "line": 0,
              "column": 0
            },
            "end": {
              "line": 0,
              "column": 10
            }
          },
          "properties": "eol"
        }
      ],
      "expected": "A+eol@0-10 T:0-10 A- T:10-21"
    },
    {
      "name": "utf8/around-multibyte",
      "source": "let café = \"x\";",
      "events": [
        {
          "type": "source",
          "startByte": 0,
          "endByte": 16
        }
      ],
      "annotations": [
        {
          "range": {
            "type": "offset",
            "start": 4,
            "end": 9
          },
          "properties": "cafe"
        }
      ],
      "expected": "T:0-4 A+cafe@4-9 T:4-9 A- T:9-16"
    },
    {
      "name": "utf8/mid-character-offset",
      "source": "let café = \"x\";",
      "events": [
        {
          "type": "source",
          "startByte": 0,
          "endByte": 16
        }
      ],
      "annotations": [
        {
          "range": {
            "type": "offset",
            "start": 4,
            "end": 8
          },
          "properties": "split-e-acute"
        }
      ],
      "expected": "ERROR: annotation 0 offset 8 is not a UTF-8 character boundary"
    },
    {
      "name": "error/offset-past-end",
      "source": "let total = 1;",
      "events": [
        {
          "type": "source",
          "startByte": 0,
          "endByte": 14
        }
      ],
      "annotations": [
        {
          "range": {
            "type": "offset",
            "start": 10,
            "end": 99
          },
          "properties": "oob"
        }
      ],
      "expected": "ERROR: annotation 0 ends at byte 99, beyond source length 14"
    },
    {
      "name": "error/position-past-end",
      "source": "let total = 1;",
      "events": [
        {
          "type": "source",
          "startByte": 0,
          "endByte": 14
        }
      ],
      "annotations": [
        {
          "range": {
            "type": "position",
            "start": {
              "line": 0,
              "column": 0
            },
            "end": {
              "line": 9,
              "column": 0
            }
          },
          "properties": "oob-pos"
        }
      ],
      "expected": "ERROR: annotation 0 line 9 is outside the source's 1 lines"
    }
  ]
}