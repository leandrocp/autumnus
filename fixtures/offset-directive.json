    {
      "name": "same-row end column reaches its own newline",
      "source": "{\n  \"a\": 1\n}\n",
      "query": "((pair) @cap (#offset! @cap 0 1 0 1))",
      "offset": ["0", "1", "0", "1"],
      "original": { "endByte": 10, "startRow": 1, "startColumn": 2, "startByte": 4, "endRow": 1, "endColumn": 8 },
