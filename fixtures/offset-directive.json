      "original": {
        "startRow": 0,
        "startColumn": 6,
        "startByte": 6,
        "endRow": 0,
        "endColumn": 11,
        "endByte": 11
      },
      "expected": {
        "startRow": 0,
        "startColumn": 7,
        "startByte": 7,
        "endRow": 0,
        "endColumn": 10,
        "endByte": 10
