    {
      "name": "same-row end column past the document end keeps the original",
      "source": "{\"a\":1}",
      "query": "((object) @cap (#offset! @cap 0 0 0 5))",
      "offset": ["0", "0", "0", "5"],
      "original": { "endByte": 7, "startRow": 0, "startColumn": 0, "startByte": 0, "endRow": 0, "endColumn": 7 },
      "expected": { "endByte": 7, "startRow": 0, "startColumn": 0, "startByte": 0, "endRow": 0, "endColumn": 7 }
    }
  ]
