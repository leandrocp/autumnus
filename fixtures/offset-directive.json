      ],
      "original": {
        "endByte": 8,
        "startRow": 0,
        "startColumn": 0,
        "startByte": 0,
        "endRow": 0,
        "endColumn": 8
      },
      "expected": {
        "endByte": 8,
        "startRow": 0,
        "startColumn": 0,
        "startByte": 0,
        "endRow": 0,
        "endColumn": 8
      }
    },
    {
      "name": "the first capture operand is its one-based capture ID",
      "source": "[\"a\",\"b\"]",
      "query": "((array (string) @first (string) @second) @cap (#offset! @cap 0 @first 0 -1))",
      "offset": [
        "0",
        "1",
        "0",
        "-1"
      ],
      "original": {
        "endByte": 9,
        "startRow": 0,
        "startColumn": 0,
        "startByte": 0,
        "endRow": 0,
        "endColumn": 9
      },
      "expected": {
        "endByte": 8,
        "startRow": 0,
        "startColumn": 1,
        "startByte": 1,
        "endRow": 0,
        "endColumn": 8
      }
    },
    {
      "name": "the second capture operand is its one-based capture ID",
      "source": "[\"a\",\"b\"]",
      "query": "((array (string) @first (string) @second) @cap (#offset! @cap 0 @second 0 -1))",
      "offset": [
        "0",
        "2",
        "0",
        "-1"
      ],
      "original": {
        "endByte": 9,
        "startRow": 0,
        "startColumn": 0,
        "startByte": 0,
        "endRow": 0,
        "endColumn": 9
      },
      "expected": {
        "endByte": 8,
        "startRow": 0,
        "startColumn": 2,
        "startByte": 2,
        "endRow": 0,
        "endColumn": 8
      }
    },
    {
      "name": "multibyte row shifts use UTF-8 byte columns",
      "source": "{\"é\": {\n        \"x\": 1,\n        \"y\": 2\n      }}",
      "query": "((object) @cap (#offset! @cap 1 0 -1 0))",
      "offset": [
        "1",
        "0",
        "-1",
        "0"
      ],
      "original": {
        "endByte": 47,
        "startRow": 0,
        "startColumn": 7,
        "startByte": 7,
        "endRow": 3,
        "endColumn": 7
      },
      "expected": {
        "endByte": 32,
        "startRow": 1,
        "startColumn": 7,
        "startByte": 16,
        "endRow": 2,
        "endColumn": 7
      }
    },
    {
      "name": "an offset inside a UTF-8 code point keeps the original range",
      "source": "{\"a\":\"éx\"}",
      "query": "((string_content) @cap (#offset! @cap 0 1 0 0))",
      "offset": [
        "0",
        "1",
