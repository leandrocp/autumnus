{
  "name": "@lumis-sh/rehype-lumis",
  "version": "0.0.1",
  "description": "rehype plugin for Lumis syntax highlighter",
  "author": "Leandro Pereira",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/leandrocp/lumis.git",
    "directory": "packages/javascript/rehype-lumis"
  },
  "bugs": "https://github.com/leandrocp/lumis/issues",
  "homepage": "https://lumis.sh",
  "keywords": [
    "rehype",
    "syntax-highlighting",
    "tree-sitter",
    "lumis"
  ],
  "sideEffects": false,
  "type": "module",
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "packageManager": "pnpm@10.31.0",
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "lint": "oxlint --type-aware src/",
    "fmt": "oxfmt src/ *.ts",
    "fmt:check": "oxfmt --check src/ *.ts"
  },
  "dependencies": {
    "@lumis-sh/lumis": "workspace:^0.0.1",
    "hast-util-from-html": "^2.0.3",
    "hast-util-to-string": "^3.0.1",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0"
  },
  "devDependencies": {
    "@types/hast": "^3.0.4",
    "oxfmt": "^0.35.0",
    "oxlint": "1.55.0",
    "oxlint-tsgolint": "0.17.0",
    "tsup": "^8.5.0",
    "typescript": "^5.9.2",
    "vitest": "^4.0.18"
  }
}
