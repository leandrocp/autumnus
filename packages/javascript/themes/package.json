{
  "name": "@lumis-sh/themes",
  "version": "0.0.2",
  "description": "Neovim themes for Lumis Syntax Highlighter",
  "author": "Leandro Pereira",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/leandrocp/lumis.git",
    "directory": "packages/javascript/themes"
  },
  "bugs": "https://github.com/leandrocp/lumis/issues",
  "keywords": [
    "lumis-sh",
    "neovim-themes"
  ],
  "homepage": "https://lumis.sh",
  "sideEffects": false,
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./json/*": "./dist/json/*.json",
    "./css/*": "./dist/css/*.css",
    "./*": {
      "types": "./dist/themes/*.d.ts",
      "import": "./dist/themes/*.js",
      "require": "./dist/themes/*.cjs"
    }
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "packageManager": "pnpm@10.31.0",
  "scripts": {
    "build:themes": "tsx scripts/build-themes.ts --step=ts",
    "build:assets": "tsx scripts/build-themes.ts --step=json && mkdir -p dist/css && cp ../../../css/*.css dist/css/",
    "build": "pnpm run build:themes && tsup && pnpm run build:assets",
    "fmt": "oxfmt src/ scripts/ *.ts",
    "fmt:check": "oxfmt --check src/ scripts/ *.ts",
    "lint": "oxlint --type-aware src/ scripts/",
    "prepack": "pnpm run build"
  },
  "devDependencies": {
    "oxfmt": "^0.35.0",
    "oxlint": "1.55.0",
    "oxlint-tsgolint": "0.17.0",
    "tsup": "^8.5",
    "tsx": "^4.21",
    "typescript": "^5.9"
  }
}
