{
  "name": "@lumis-sh/markdown-it-lumis",
  "version": "0.0.1",
  "description": "markdown-it plugin for Lumis syntax highlighting",
  "author": "Leandro Pereira",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/leandrocp/lumis.git",
    "directory": "packages/javascript/markdown-it-lumis"
  },
  "bugs": "https://github.com/leandrocp/lumis/issues",
  "homepage": "https://lumis.sh",
  "keywords": [
    "markdown-it",
    "syntax-highlighting",
    "tree-sitter",
    "lumis"
  ],
  "sideEffects": false,
  "type": "module",
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "packageManager": "pnpm@10.31.0",
  "scripts": {
    "build": "tsup",
    "lint": "oxlint --type-aware src/",
    "fmt": "oxfmt src/ *.ts",
    "fmt:check": "oxfmt --check src/ *.ts"
  },
  "dependencies": {
    "@lumis-sh/lumis": "workspace:^0.0.1",
    "@lumis-sh/themes": "workspace:^0.0.2",
    "markdown-it": "^14.1.0"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.1.2",
    "oxfmt": "^0.35.0",
    "oxlint": "1.55.0",
    "oxlint-tsgolint": "0.17.0",
    "tsup": "^8.5.0",
    "typescript": "^5.9.2"
  }
}
