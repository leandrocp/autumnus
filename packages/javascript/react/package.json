{
  "name": "@lumis-sh/react",
  "version": "0.1.0",
  "description": "React integration for Lumis syntax highlighting",
  "author": "Leandro Pereira",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/leandrocp/lumis.git",
    "directory": "packages/javascript/react"
  },
  "bugs": "https://github.com/leandrocp/lumis/issues",
  "homepage": "https://lumis.sh",
  "keywords": [
    "react",
    "lumis-sh",
    "syntax-highlighting",
    "tree-sitter"
  ],
  "sideEffects": false,
  "type": "module",
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "packageManager": "pnpm@10.31.0",
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "lint": "oxlint --type-aware src/",
    "fmt": "oxfmt src/ test/ *.ts",
    "fmt:check": "oxfmt --check src/ test/ *.ts",
    "prepack": "pnpm run build"
  },
  "dependencies": {
    "@lumis-sh/lumis": "workspace:^0.0.1",
    "hast-util-from-html": "^2.0.3",
    "hast-util-to-jsx-runtime": "^2.3.6"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "devDependencies": {
    "@microsoft/api-extractor": "^7.36.0",
    "@types/hast": "^3.0.4",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "jsdom": "^27.0.0",
    "oxfmt": "^0.43.0",
    "oxlint": "1.58.0",
    "oxlint-tsgolint": "0.19.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.0",
    "tsup": "^8.5.0",
    "typescript": "^6.0.2",
    "vitest": "^4.1.2"
  }
}
