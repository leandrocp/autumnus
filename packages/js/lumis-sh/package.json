{
  "name": "lumis-sh",
  "version": "0.0.1",
  "description": "Syntax Highlighter powered by Tree-sitter and Neovim themes.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/leandrocp/lumis",
    "directory": "packages/js/lumis-sh"
  },
  "homepage": "https://lumis.sh",
  "keywords": [
    "syntax-highlighting",
    "tree-sitter",
    "highlighter",
    "code-highlighting"
  ],
  "sideEffects": false,
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./langs/*": {
      "types": "./dist/langs/*.d.ts",
      "import": "./dist/langs/*.js",
      "require": "./dist/langs/*.cjs"
    },
    "./themes/*": {
      "types": "./dist/themes/*.d.ts",
      "import": "./dist/themes/*.js",
      "require": "./dist/themes/*.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build:langs": "tsx scripts/build-langs.ts",
    "build:themes": "tsx scripts/build-themes.ts",
    "build:wasm": "tsx scripts/build-wasm.ts",
    "build:generate": "npm run build:wasm && npm run build:langs && npm run build:themes",
    "build": "npm run build:generate && tsup",
    "test": "vitest run",
    "dev": "vite"
  },
  "dependencies": {
    "web-tree-sitter": "^0.25.3"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "tsup": "^8.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vite": "^7.3.1",
    "vitest": "^4.0.18"
  }
}
